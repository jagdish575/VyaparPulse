# KirAI — environment overview. Copy the relevant lines into backend/.env and frontend/.env.local.
# NEVER commit real keys. The EURI key lives ONLY in backend/.env and is never sent to the browser.

# ---- backend/.env ----
EURI_API_KEY=
EURI_BASE_URL=https://api.euron.one/api/v1/euri
EURI_MODEL=gpt-4.1-nano
FRONTEND_URL=http://localhost:3000
DEMO_MODE=true            # local demo only; leave false (the default) for a real store
OWNER_PASSWORD_HASH=      # python -m app.auth_setup

# ---- frontend/.env.local ----
NEXT_PUBLIC_API_URL=http://localhost:8000
