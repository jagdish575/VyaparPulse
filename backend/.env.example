# EURI (OpenAI-compatible gateway). Get a key from your EURI / Euron dashboard.
EURI_API_KEY=
# Documented EURI base URL (POST {base}/chat/completions). Leave as-is unless EURI tells you otherwise.
EURI_BASE_URL=https://api.euron.one/api/v1/euri
# Any chat model enabled on your EURI account, e.g. gpt-4.1-nano or gemini-2.5-flash
EURI_MODEL=gpt-4.1-nano
# Hard cap (seconds) for one EURI call; slower than this -> the local parser is used (and labelled in the UI)
# EURI_TIMEOUT_SECONDS=8

# Allowed browser origin for CORS and cookie sessions: your exact frontend URL (e.g. https://kirai.vercel.app).
# Wildcards are NOT allowed. Add more origins with EXTRA_ORIGINS=https://a.example,https://b.example
FRONTEND_URL=http://localhost:3000

# ---- Demo mode (OFF by default) ----------------------------------------------------------------
# true  = seeds fictitious data on startup and enables "Reset Demo Data" (which DELETES EVERYTHING,
#         including the financial ledger). Use ONLY for a demo / local hackathon run.
# false = a real store: no demo data is ever created and reset/seed are refused.
DEMO_MODE=false

# ---- Owner login ---------------------------------------------------------------------------------
# Create a hash with:  python -m app.auth_setup   -> paste the OWNER_PASSWORD_HASH=... line here.
# With a password set, every private API route requires sign-in. With no password and DEMO_MODE=false the
# private API answers 503 (it never falls back to "open"). With DEMO_MODE=true and no password it is open.
OWNER_PASSWORD_HASH=
# Quick local demos only (kept in plain text!). Prefer OWNER_PASSWORD_HASH.
# OWNER_PASSWORD=
# SESSION_TTL_HOURS=12
# Frontend and API on different sites (e.g. Vercel + Render): COOKIE_SAMESITE=none and COOKIE_SECURE=true (HTTPS).
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false

# Optional overrides
# DATABASE_URL=sqlite:///./kirai.db
# STORE_NAME=Sharma Kirana Store
# STORE_LOCATION=Vijay Nagar, Indore
# DELIVERY_CHARGE=30
# FREE_DELIVERY_ABOVE=999
